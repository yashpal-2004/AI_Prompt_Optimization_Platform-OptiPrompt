// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - email: string (required) - User email
//   - displayName: string (optional) - User display name
//   - role: string (required, enum: ['admin', 'user']) - User role
//   - createdAt: timestamp (required) - Account creation timestamp
//
// Collection: usageLogs
// Document ID: {logId} (Auto-generated)
// Fields:
//   - uid: string (required) - User UID
//   - originalPrompt: string (required) - Original user prompt
//   - optimizedPrompt: string (required) - Optimized prompt
//   - originalTokens: number (optional) - Tokens in original prompt
//   - optimizedTokens: number (optional) - Tokens in optimized prompt
//   - tokensSaved: number (optional) - Tokens saved
//   - provider/model: string - Provider used for this optimization
//   - apiInputTokens/apiOutputTokens: number (optional) - Provider-reported usage
//   - estimatedApiCostUsd: number (optional) - Estimated cost at published rates
//   - latencyMs: number - End-to-end provider latency
//   - mode: string (required, enum: ['cheap', 'quality', 'extreme']) - Optimization mode
//   - model: string (optional) - Model used
//   - timestamp: timestamp (required) - When the optimization occurred
//
// Collection: analytics
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required) - User UID
//   - totalTokensSaved: number (required) - Total tokens saved
//   - totalCostSaved: number (required) - Total cost saved
//   - lastUpdated: timestamp (optional) - Last update timestamp
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isNewDocOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.role in ['user', 'admin'] &&
             data.email is string && data.email.size() > 0;
    }

    function isValidUsageLog(data) {
      return data.keys().hasAll([
               'uid', 'originalPrompt', 'optimizedPrompt', 'originalTokens',
               'optimizedTokens', 'tokensSaved', 'mode', 'provider', 'model',
               'latencyMs', 'timestamp'
             ]) &&
             data.keys().hasOnly([
               'uid', 'originalPrompt', 'optimizedPrompt', 'originalTokens',
               'optimizedTokens', 'tokensSaved', 'mode', 'provider', 'model',
               'latencyMs', 'apiInputTokens', 'apiOutputTokens',
               'estimatedApiCostUsd', 'timestamp'
             ]) &&
             data.uid == request.auth.uid &&
             data.originalPrompt is string && data.originalPrompt.size() > 0 && data.originalPrompt.size() <= 10000 &&
             data.optimizedPrompt is string && data.optimizedPrompt.size() > 0 && data.optimizedPrompt.size() <= 10000 &&
             data.originalTokens is int && data.originalTokens >= 0 &&
             data.optimizedTokens is int && data.optimizedTokens >= 0 &&
             data.tokensSaved is int &&
             data.mode in ['cheap', 'quality', 'extreme'] &&
             data.provider in ['groq', 'gemini', 'local cache'] &&
             data.model is string && data.model.size() > 0 && data.model.size() <= 100 &&
             data.latencyMs is int && data.latencyMs >= 0 && data.latencyMs <= 120000 &&
             data.timestamp is timestamp &&
             (!data.keys().hasAny(['apiInputTokens']) || (data.apiInputTokens is int && data.apiInputTokens >= 0)) &&
             (!data.keys().hasAny(['apiOutputTokens']) || (data.apiOutputTokens is int && data.apiOutputTokens >= 0)) &&
             (!data.keys().hasAny(['estimatedApiCostUsd']) || (data.estimatedApiCostUsd is number && data.estimatedApiCostUsd >= 0));
    }

    function isValidAnalytics(data) {
      return data.keys().hasAll(['uid', 'totalTokensSaved', 'totalCostSaved']) &&
             data.uid == request.auth.uid &&
             data.totalTokensSaved is number &&
             data.totalCostSaved is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      request.resource.data.role == resource.data.role; // Prevent self-promotion
      allow delete: if false; // Users cannot delete their profiles
    }

    match /usageLogs/{logId} {
      allow read: if isDocOwner();
      allow create: if isNewDocOwner() && isValidUsageLog(request.resource.data);
      allow update: if isDocOwner() && isNewDocOwner() && isValidUsageLog(request.resource.data);
      allow delete: if isDocOwner();
    }

    match /analytics/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidAnalytics(request.resource.data);
      allow update: if isOwner(userId) && isValidAnalytics(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
