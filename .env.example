# Server-only provider keys. Never add a VITE_ prefix.
GROQ_API_KEY=your_rotated_groq_key_here
GROQ_API_KEY_2=your_secondary_groq_key_here # optional
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model overrides. Defaults are current supported models.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash

# Project Config
VITE_PROJECT_NAME=OptiPrompt
VITE_ENV=development
API_RATE_LIMIT_PER_MIN=10
